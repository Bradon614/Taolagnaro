# Copy to .env.local and fill in the values you actually have.
# Anything left empty is treated as "not configured" and the matching link is
# simply not rendered — the site never shows a placeholder phone number,
# WhatsApp account, e-mail address or social link.

# Public origin, used by the sitemap, robots and canonical metadata.
# NEXT_PUBLIC_SITE_URL="https://taolagnaro.mg"

# Platform contact details (not the establishments — those carry their own
# sourced contact block on their detail page).
# NEXT_PUBLIC_SITE_PHONE="+261 34 12 345 67"
# NEXT_PUBLIC_SITE_WHATSAPP="261341234567"        # digits only, no + and no spaces
# NEXT_PUBLIC_SITE_EMAIL="bonjour@taolagnaro.mg"
# NEXT_PUBLIC_SITE_FACEBOOK="https://www.facebook.com/your-page"
# NEXT_PUBLIC_SITE_INSTAGRAM="https://www.instagram.com/your-account"
